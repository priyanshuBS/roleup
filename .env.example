# Neon pooled connection string (host contains "-pooler"). Used by the web app and workers.
# For local development you can instead run `pnpm db:local` and use:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# DB_POOL_MAX=1   (required with the local PGlite server: it runs one engine, one connection)
DATABASE_URL=
# Neon direct (unpooled) connection string, used only for migrations.
DATABASE_URL_UNPOOLED=
# Protects /admin and /api/admin/*. Use a long random string.
ADMIN_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Static USD->INR rate for salary conversion.
USD_INR_RATE=84
# Sent in the crawler User-Agent so ATS operators can reach us.
CRAWLER_CONTACT_EMAIL=
