{
  "name": "roleup",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @roleup/db generate",
    "db:migrate": "pnpm --filter @roleup/db migrate",
    "db:local": "pnpm --filter @roleup/db local",
    "db:seed": "pnpm --filter @roleup/workers seed",
    "crawl": "pnpm --filter @roleup/workers crawl",
    "sync-yc": "pnpm --filter @roleup/workers sync-yc",
    "track-funding": "pnpm --filter @roleup/workers track-funding",
    "detect-ats": "pnpm --filter @roleup/workers detect-ats"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
